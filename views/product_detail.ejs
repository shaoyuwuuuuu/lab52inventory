<%- include('partials/_head', { page: 'products' }) %>

<div class="d-flex justify-content-between align-items-start mb-3">
  <div>
    <a href="/products" class="text-muted text-decoration-none small"><i class="bi bi-arrow-left"></i> 返回列表</a>
    <div class="page-title mt-1 mb-0"><%= product.name %></div>
    <div class="text-muted small">
      <% if(product.sku) { %>SKU: <strong><%= product.sku %></strong>&ensp;<% } %>
      <% if(product.ean) { %>EAN: <strong><%= product.ean %></strong>&ensp;<% } %>
      <% if(product.cubic_feet_per_carton) { %><%= product.cubic_feet_per_carton %> ft³/箱&ensp;<% } %>
      <% if(product.qty_per_carton) { %><%= product.qty_per_carton %> pcs/箱<% } %>
    </div>
  </div>
  <div class="d-flex gap-2">
    <a href="/movements/new?product_id=<%= product.id %>" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>新增異動</a>
    <a href="/products/<%= product.id %>/edit" class="btn btn-outline-secondary btn-sm">編輯</a>
    <form action="/products/<%= product.id %>/delete" method="POST" onsubmit="return confirm('確定刪除此產品及所有批次紀錄？')">
      <button class="btn btn-outline-danger btn-sm">刪除</button>
    </form>
  </div>
</div>

<!-- 批次表格 -->
<div class="card mb-3">
  <div class="card-header d-flex justify-content-between align-items-center">
    <span class="fw-bold"><i class="bi bi-layers me-1"></i>批次列表</span>
    <button class="btn btn-sm btn-outline-primary" data-bs-toggle="collapse" data-bs-target="#addBatchForm">
      <i class="bi bi-plus"></i> 新增批次
    </button>
  </div>

  <!-- 新增批次表單 -->
  <div class="collapse" id="addBatchForm">
    <div class="card-body border-bottom bg-light">
      <form action="/products/<%= product.id %>/batches" method="POST" class="row g-2 align-items-end">
        <div class="col-md-3">
          <label class="form-label small mb-1">效期 EXP</label>
          <input type="date" name="exp_date" class="form-control form-control-sm">
        </div>
        <div class="col-md-2">
          <label class="form-label small mb-1">位置</label>
          <select name="location" class="form-select form-select-sm">
            <option value="AMZLGS">AMZLGS</option>
            <option value="FBA">Amazon FBA</option>
          </select>
        </div>
        <div class="col-md-2">
          <label class="form-label small mb-1">現存箱數</label>
          <input type="number" step="0.1" name="current_cartons" class="form-control form-control-sm" value="0">
        </div>
        <div class="col-md-3">
          <label class="form-label small mb-1">備註</label>
          <input type="text" name="note" class="form-control form-control-sm">
        </div>
        <div class="col-md-2">
          <button type="submit" class="btn btn-primary btn-sm w-100">新增</button>
        </div>
      </form>
    </div>
  </div>

  <div class="card-body p-0">
    <table class="table table-sm table-hover mb-0">
      <thead><tr><th>效期 EXP</th><th>位置</th><th class="text-center">現存箱數</th><th class="text-center">換算 PCS</th><th>備註</th><th></th></tr></thead>
      <tbody>
      <% if (batches.length === 0) { %>
        <tr><td colspan="6" class="text-center text-muted py-3">尚無批次，請新增</td></tr>
      <% } %>
      <% batches.forEach(b => { %>
        <tr>
          <td>
            <% if (b.exp_date) { %>
              <% const daysLeft = Math.round((new Date(b.exp_date) - new Date()) / 86400000); %>
              <%= b.exp_date %>
              <% if (daysLeft <= 30) { %><span class="badge bg-danger ms-1">剩<%= daysLeft %>天</span>
              <% } else if (daysLeft <= 90) { %><span class="badge bg-warning text-dark ms-1">剩<%= daysLeft %>天</span>
              <% } else if (daysLeft <= 180) { %><span class="badge bg-secondary ms-1">剩<%= daysLeft %>天</span><% } %>
            <% } else { %>—<% } %>
          </td>
          <td><span class="badge bg-info text-dark"><%= b.location %></span></td>
          <td class="text-center <%= b.current_cartons <= 0 ? 'text-danger fw-bold' : '' %>"><%= b.current_cartons %></td>
          <td class="text-center text-muted">
            <% if (product.qty_per_carton) { %><%= Math.round(b.current_cartons * product.qty_per_carton) %><% } else { %>—<% } %>
          </td>
          <td><small class="text-muted"><%= b.note || '' %></small></td>
          <td>
            <form action="/batches/<%= b.id %>/delete" method="POST" onsubmit="return confirm('刪除此批次？')">
              <button class="btn btn-sm btn-outline-danger py-0">刪</button>
            </form>
          </td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </div>
</div>

<!-- 異動紀錄 -->
<div class="card">
  <div class="card-header fw-bold" data-bs-toggle="collapse" data-bs-target="#movementsCollapse"
       style="cursor:pointer; user-select:none">
    <i class="bi bi-clock-history me-1"></i>異動紀錄（最近50筆）
    <i class="bi bi-chevron-down float-end"></i>
  </div>
  <div class="collapse" id="movementsCollapse">
    <div class="card-body p-0">
      <table class="table table-sm mb-0">
        <thead><tr><th>日期</th><th>批次EXP</th><th>類型</th><th class="text-center">箱數</th><th>備註</th></tr></thead>
        <tbody>
        <% if (movements.length === 0) { %>
          <tr><td colspan="5" class="text-center text-muted py-3">尚無異動記錄</td></tr>
        <% } %>
        <% movements.forEach(m => { %>
          <tr>
            <td><%= m.date %></td>
            <td><small><%= m.exp_date || '—' %></small></td>
            <td><span class="badge <%= m.qty_cartons > 0 ? 'bg-success' : 'bg-danger' %>"><%= m.type %></span></td>
            <td class="text-center"><%= m.qty_cartons > 0 ? '+' : '' %><%= m.qty_cartons %></td>
            <td><small class="text-muted"><%= m.note || '' %></small></td>
          </tr>
        <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('partials/_foot') %>
