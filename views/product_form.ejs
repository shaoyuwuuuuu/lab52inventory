<%- include('partials/_head', { page: 'products' }) %>

<div class="mb-3"><a href="/products" class="text-muted text-decoration-none small"><i class="bi bi-arrow-left"></i> 返回列表</a></div>
<div class="page-title"><%= product ? '編輯產品' : '新增產品' %></div>

<div class="card" style="max-width:600px">
  <div class="card-body">
    <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
    <form action="<%= product ? '/products/'+product.id+'/edit' : '/products' %>" method="POST">
      <div class="mb-3">
        <label class="form-label">產品名稱 <span class="text-danger">*</span></label>
        <input type="text" name="name" class="form-control" value="<%= product?.name || '' %>" required>
      </div>
      <div class="mb-3">
        <label class="form-label">ASIN</label>
        <input type="text" name="asin" class="form-control" value="<%= product?.asin || '' %>" placeholder="B0XXXXXXXX">
      </div>
      <div class="row g-2 mb-3">
        <div class="col">
          <label class="form-label">SKU</label>
          <input type="text" name="sku" class="form-control" value="<%= product?.sku || '' %>">
        </div>
        <div class="col">
          <label class="form-label">EAN / 條碼</label>
          <input type="text" name="ean" class="form-control" value="<%= product?.ean || '' %>">
        </div>
      </div>
      <div class="row g-2 mb-3">
        <div class="col">
          <label class="form-label">體積（ft³/箱）</label>
          <input type="number" step="0.001" name="cubic_feet_per_carton" class="form-control" value="<%= product?.cubic_feet_per_carton || '' %>">
        </div>
        <div class="col">
          <label class="form-label">PCS / 箱</label>
          <input type="number" name="qty_per_carton" class="form-control" value="<%= product?.qty_per_carton || '' %>">
        </div>
      </div>
      <div class="mb-3">
        <label class="form-label">備註</label>
        <textarea name="note" class="form-control" rows="2"><%= product?.note || '' %></textarea>
      </div>
      <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary"><%= product ? '儲存' : '新增' %></button>
        <a href="/products" class="btn btn-outline-secondary">取消</a>
      </div>
    </form>
  </div>
</div>

<%- include('partials/_foot') %>
