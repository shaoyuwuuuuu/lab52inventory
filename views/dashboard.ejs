<%- include('partials/_head', { page: 'dashboard' }) %>

<div class="page-title"><i class="bi bi-speedometer2 me-2"></i>庫存總覽</div>

<!-- 統計卡片 -->
<div class="row g-3 mb-4">
  <div class="col-md-4">
    <div class="card stat-card blue p-3">
      <div class="text-muted small">產品種類</div>
      <div class="fs-2 fw-bold text-primary"><%= stats.product_count || 0 %></div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card stat-card green p-3">
      <div class="text-muted small">批次數量</div>
      <div class="fs-2 fw-bold text-success"><%= stats.batch_count || 0 %></div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card stat-card yellow p-3">
      <div class="text-muted small">在倉總箱數</div>
      <div class="fs-2 fw-bold text-warning"><%= (stats.total_cartons || 0).toFixed(1) %></div>
    </div>
  </div>
</div>

<div class="row g-3">
  <!-- 即將到期 -->
  <div class="col-lg-7">
    <div class="card p-3">
      <div class="fw-bold mb-3 text-danger"><i class="bi bi-exclamation-triangle me-1"></i>即將到期（6個月內）</div>
      <% if (expiringSoon.length === 0) { %>
        <p class="text-muted small mb-0">無即將到期批次</p>
      <% } else { %>
      <table class="table table-sm table-hover mb-0">
        <thead><tr><th>產品</th><th>EXP</th><th>剩餘天數</th><th>現存箱數</th></tr></thead>
        <tbody>
        <% expiringSoon.forEach(b => { %>
          <tr>
            <td><a href="/products/<%= b.id %>" class="text-decoration-none"><%= b.name %></a>
              <% if(b.sku) { %><br><small class="text-muted"><%= b.sku %></small><% } %></td>
            <td><%= b.exp_date %></td>
            <td>
              <% if (b.days_left <= 30) { %>
                <span class="badge bg-danger"><%= b.days_left %> 天</span>
              <% } else if (b.days_left <= 90) { %>
                <span class="badge bg-warning text-dark"><%= b.days_left %> 天</span>
              <% } else { %>
                <span class="badge bg-secondary"><%= b.days_left %> 天</span>
              <% } %>
            </td>
            <td><%= b.current_cartons %> 箱
              <% if (b.qty_per_carton) { %><small class="text-muted">(≈<%= Math.round(b.current_cartons * b.qty_per_carton) %>pcs)</small><% } %>
            </td>
          </tr>
        <% }) %>
        </tbody>
      </table>
      <% } %>
    </div>
  </div>

  <!-- 近期異動 -->
  <div class="col-lg-5">
    <div class="card p-3">
      <div class="fw-bold mb-3"><i class="bi bi-clock-history me-1"></i>近期異動</div>
      <% if (recentMoves.length === 0) { %>
        <p class="text-muted small mb-0">尚無異動記錄</p>
      <% } else { %>
      <div style="max-height:320px;overflow-y:auto;">
        <% recentMoves.forEach(m => { %>
          <div class="d-flex justify-content-between align-items-start border-bottom py-2">
            <div>
              <div class="small fw-bold"><%= m.product_name %></div>
              <div class="text-muted" style="font-size:.75rem;"><%= m.date %> &bull; <%= m.type %></div>
            </div>
            <span class="badge <%= m.qty_cartons > 0 ? 'bg-success' : 'bg-danger' %> ms-2">
              <%= m.qty_cartons > 0 ? '+' : '' %><%= m.qty_cartons %> 箱
            </span>
          </div>
        <% }) %>
      </div>
      <% } %>
      <div class="mt-2"><a href="/movements/new" class="btn btn-sm btn-outline-primary w-100"><i class="bi bi-plus"></i> 新增異動</a></div>
    </div>
  </div>
</div>

<%- include('partials/_foot') %>
