<%- include('partials/_head', { page: '' }) %>

<div class="page-title"><i class="bi bi-plus-circle me-2"></i>新增庫存異動</div>

<div class="card" style="max-width:620px">
  <div class="card-body">
    <form action="/movements" method="POST" id="mvForm">

      <div class="mb-3">
        <label class="form-label fw-semibold">選擇批次</label>
        <select name="batch_id" class="form-select" required id="batchSelect">
          <option value="">— 請選擇產品批次 —</option>
          <%
            let lastProduct = '';
            products.forEach(p => {
              if (p.name !== lastProduct) {
          %>
                <% if (lastProduct) { %></optgroup><% } %>
                <optgroup label="<%= p.name %>">
          <%   lastProduct = p.name; } %>
              <option value="<%= p.batch_id %>" <%= prefill.batch_id == p.batch_id ? 'selected':'' %>>
                EXP: <%= p.exp_date || '無效期' %> — <%= p.current_cartons %> 箱 (<%= p.location %>)
              </option>
          <% }); %>
          <% if (lastProduct) { %></optgroup><% } %>
        </select>
      </div>

      <div class="row g-2 mb-3">
        <div class="col-md-6">
          <label class="form-label fw-semibold">日期</label>
          <input type="date" name="date" class="form-control" value="<%= new Date().toISOString().slice(0,10) %>" required>
        </div>
        <div class="col-md-6">
          <label class="form-label fw-semibold">異動類型</label>
          <select name="type" class="form-select" required>
            <optgroup label="入庫 ＋">
              <option value="IN">進貨</option>
              <option value="IN_RETURN">退貨入庫</option>
            </optgroup>
            <optgroup label="出庫 －">
              <option value="OUT_FBA">FBA 出貨</option>
              <option value="OUT_DROPSHIP">Dropship 出貨</option>
            </optgroup>
            <optgroup label="其他">
              <option value="REPACK">Repack</option>
              <option value="ADJUST">盤點調整</option>
            </optgroup>
          </select>
        </div>
      </div>

      <div class="mb-3">
        <label class="form-label fw-semibold">箱數</label>
        <div class="input-group">
          <input type="number" step="0.1" name="qty_cartons" class="form-control" placeholder="輸入箱數（出庫輸入正數即可）" required min="0.1">
          <span class="input-group-text">箱</span>
        </div>
        <div class="form-text">出庫類型系統會自動轉為負數</div>
      </div>

      <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">儲存</button>
        <a href="/" class="btn btn-outline-secondary">取消</a>
      </div>
    </form>
  </div>
</div>

<%- include('partials/_foot') %>
