<%- include('partials/_head', { page: 'billing' }) %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <div class="page-title mb-0"><i class="bi bi-receipt me-2"></i>帳單紀錄</div>
  <a href="/billing/new" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>新增帳單</a>
</div>

<!-- 月份篩選 -->
<div class="d-flex gap-2 mb-3 flex-wrap">
  <a href="/billing" class="btn btn-sm <%= !selectedMonth ? 'btn-secondary' : 'btn-outline-secondary' %>">全部</a>
  <% months.forEach(m => { %>
    <a href="/billing?month=<%= m.ym %>" class="btn btn-sm <%= selectedMonth===m.ym ? 'btn-secondary' : 'btn-outline-secondary' %>"><%= m.ym %></a>
  <% }) %>
</div>

<% if (monthTotal && selectedMonth) { %>
<div class="alert alert-info py-2">
  <strong><%= selectedMonth %></strong> 月帳單合計：<strong class="text-danger">$<%= (monthTotal.total||0).toFixed(2) %></strong>
</div>
<% } %>

<div class="card">
  <div class="card-body p-0">
    <table class="table table-sm table-hover mb-0">
      <thead>
        <tr><th>日期</th><th>類型</th><th>項目說明</th><th class="text-end">數量</th><th class="text-end">單價</th><th class="text-end">小計</th><th></th></tr>
      </thead>
      <tbody>
      <% if (rows.length === 0) { %>
        <tr><td colspan="7" class="text-center text-muted py-4">尚無帳單資料，請先 <a href="/import">匯入</a> 或手動 <a href="/billing/new">新增</a></td></tr>
      <% } %>
      <% rows.forEach(r => { %>
        <tr>
          <td><%= r.date %></td>
          <td>
            <% const typeColor = {STORAGE:'secondary',FBA:'primary',DROPSHIP:'success',POSTAGE:'info',RESTICKER:'warning',REPACK:'warning','REPACK+RESTICKER':'warning',CHECKIN:'dark','CHECK IN':'dark',PALLET:'dark'}; %>
            <span class="badge bg-<%= typeColor[r.type] || 'secondary' %>"><%= r.type %></span>
          </td>
          <td><small><%= r.job_name || '—' %></small></td>
          <td class="text-end"><small><%= r.qty != null ? r.qty : '—' %></small></td>
          <td class="text-end"><small><%= r.unit_fee != null ? '$'+r.unit_fee.toFixed(2) : '—' %></small></td>
          <td class="text-end fw-semibold"><%= r.total_fee != null ? '$'+r.total_fee.toFixed(2) : '—' %></td>
          <td>
            <form action="/billing/<%= r.id %>/delete" method="POST" onsubmit="return confirm('確定刪除？')">
              <button class="btn btn-sm btn-outline-danger py-0">刪</button>
            </form>
          </td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/_foot') %>
